generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id         String     @id @default(uuid())
  title      String     @db.VarChar(225)
  content    String     @db.Text
  thumbnail  String?
  isFeatured Boolean    @default(false)
  status     PostStatus @default(PUBLISHED)
  tags       String[]
  views      Int        @default(0)
  authorId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  comments Comment[]

  @@index([authorId])
  @@map("posts")
}

model Comment {
  id             String        @id @default(uuid())
  content        String        @db.Text
  authotId       String
  postId         String
  postRelation   Post          @relation(fields: [postId], references: [id])
  parentId       String?
  parentRelation Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies        Comment[]     @relation("CommentReplies")
  status         CommentStatus @default(APPROVED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([postId])
  @@index([authotId])
  @@map("comments")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  APPROVED
  REJECT
}
